{
  "chapter": "ch17",
  "scenes": [
    {
      "trigger": "before:p111",
      "note": "지도 161판 · 17장 시작 · 고요 사원이 하얗게 지워지는 중",
      "steps": [
        { "title": "17장", "sub": "하얘지는 사원" },
        { "narr": "산 위 고요 사원. 지붕 끝부터 기둥까지 그림이 한 줄씩 지워지고, 그 자리에 하얀 종이가 드러나 있다." },
        { "enter": "muk", "at": "right" },
        { "say": "muk", "text": "왔냐." },
        { "enter": "grenn", "at": "left" },
        { "say": "grenn", "text": "사원이 반은 없어졌다. 영감은 그동안 뭐 했냐." },
        { "say": "muk", "text": "앉아 있었다." },
        { "enter": "yuja", "at": "left2", "face": "sad" },
        { "say": "yuja", "text": "스승님 방석은 안 지워졌네요." },
        { "say": "muk", "text": "지우개는 화로 막는 게 아니다. 화내면 같이 지워진다." },
        { "say": "grenn", "text": "그럼 뭐로 막냐." },
        { "say": "muk", "text": "모른다. 그래서 앉아 있었다." },
        { "say": "grenn", "face": "tired", "text": "그럼 계속 앉아 있어라. 가루는 내가 치운다." }
      ]
    },
    {
      "trigger": "before:p112",
      "note": "지도 162판",
      "steps": [
        { "enter": "monk", "at": "right" },
        { "say": "monk", "text": "물러나시오. 이 사원은 깨끗이 지운 뒤 새 종이로 돌려놓을 것이오." },
        { "enter": "pio", "at": "left", "face": "scared" },
        { "say": "pio", "text": "흰 두건, 그 사람들이에요. 두건 접은 모양까지 똑같아요." },
        { "say": "monk", "text": "망친 곳은 언젠가 버려지오. 버려지기 전에 깨끗이 해 두는 것뿐이오." },
        { "say": "pio", "face": "angry", "text": "망친 데가 아니에요. 저 기둥에 키 잰 자국 보이잖아요. 누가 살던 데예요." }
      ]
    },
    {
      "trigger": "before:b051",
      "note": "지도 163판 · 꼬불이 둘",
      "steps": [
        { "enter": "scribble", "at": "right", "face": "angry" },
        { "say": "scribble", "text": "꼬불, 끼긱!" },
        { "enter": "danpung", "at": "left" },
        { "say": "danpung", "text": "지워진 자리 틈으로 휘갈김이 기어 나옵니다. 종이가 얇아진 탓입니다." },
        { "enter": "grenn", "at": "left2" },
        { "say": "grenn", "text": "지우면 지울수록 구멍만 느는군. 흰 두건들이 지나간 자리가 다 이렇다." }
      ]
    },
    {
      "trigger": "before:p113",
      "note": "지도 164판 · 테이프 판",
      "steps": [
        { "enter": "ttukttak", "at": "left" },
        { "enter": "muk", "at": "right" },
        { "say": "ttukttak", "text": "지워진 데가 너무 얇아서 누르면 찢어지겠어! 뒤에 테이프를 대야 돼, 가로로 한 번 세로로 한 번." },
        { "say": "muk", "text": "붙여라." },
        { "say": "ttukttak", "face": "think", "text": "할아버지, 테이프 붙이면 자국 남는데 괜찮아? 볕 받으면 누레지기도 해. 우리 할머니 창호지도 그랬거든." },
        { "say": "muk", "text": "자국 없는 건 없다." }
      ]
    },
    {
      "trigger": "before:p114",
      "note": "지도 165판",
      "steps": [
        { "enter": "riv", "at": "right", "face": "sad" },
        { "enter": "grenn", "at": "left" },
        { "say": "riv", "text": "사원 기록 창고도 절반이 하얘졌어요. 수행자 명부가 제일 먼저 지워졌어요." },
        { "say": "grenn", "text": "베껴 둔 건 있냐." },
        { "say": "riv", "face": "think", "text": "서고탑에 사본이 있어요. 분류 번호 삼백십이, 사원 명부 둘째 권이요. 이름은 다시 쓸 수 있어요." },
        { "say": "grenn", "face": "think", "text": "다시 쓸 수 있다는 거군." }
      ]
    },
    {
      "trigger": "before:b052",
      "note": "지도 166판 · 가시볼 둘 (도전)",
      "steps": [
        { "shake": "screen" },
        { "enter": "scribble", "at": "right", "face": "angry" },
        { "say": "scribble", "text": "따각따각따각!" },
        { "enter": "yuja", "at": "left", "face": "angry" },
        { "narr": "유자가 방패를 번쩍 쳐들다가, 어깨에 힘이 잔뜩 들어간 채로 멈춘다." },
